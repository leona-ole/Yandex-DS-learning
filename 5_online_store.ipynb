   "source": [
    "# SimpleImputer + OHE\n",
    "try:\n",
    "    ohe_pipe = Pipeline(\n",
    "        [\n",
    "            (\n",
    "                'simpleImputer_ohe', \n",
    "                SimpleImputer(missing_values=np.nan, strategy='most_frequent')\n",
    "            ),\n",
    "            (\n",
    "                'ohe', \n",
    "                OneHotEncoder(drop='first', handle_unknown='ignore', sparse_output=False)\n",
    "            )\n",
    "        ]\n",
    "    )\n",
    "except:\n",
    "    ohe_pipe = Pipeline(\n",
    "    [\n",
    "        (\n",
    "            'simpleImputer_ohe', \n",
    "            SimpleImputer(missing_values=np.nan, strategy='most_frequent')\n",
    "        ),\n",
    "        (\n",
    "            'ohe', \n",
    "            OneHotEncoder(drop='first', handle_unknown='ignore', sparse=False)\n",
    "        )\n",
    "    ]\n",
    ")\n",
    "\n",
    "ohe_pipe"
   ]
  },
